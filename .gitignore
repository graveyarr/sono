# Скачанная музыка и обложки — чужие авторские материалы, в репозиторий НЕЛЬЗЯ
cache/

# Сборка .exe (python build.py) — пересоздаётся каждый раз.
# Готовый установщик SonoSetup.exe выкладывается в GitHub Releases, а не в код.
build/
dist/
*.spec

# Данные запущенного приложения (личные плейлисты, избранное, история)
library.json
instance.json
library.tmp
network.json
# Свои файлы с компьютера: какие папки добавил человек (localfiles.py)
local.json
local.tmp
library.broken-*.json
sono.log
player.log
webview/
# Автонастройка zapret: скрипт, параметры и ход подбора
zapret/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Редакторы и система
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
desktop.ini
.DS_Store

# Android (папка android/): путь к SDK на этом компьютере и служебные файлы Gradle
android/local.properties
android/.gradle/
android/.kotlin/
# Свои темы оформления при запуске из исходников (встроенные — в static/themes, их не трогаем)
/themes/
